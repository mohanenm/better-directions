{
  "name": "better-directions",
  "private": true,
  "version": "0.1.0",
  "description": "A deliberately silly walking router. Static web app.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test",
    "bench": "vitest run --config vitest.bench.config.ts --silent=false --disableConsoleIntercept"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.7",
    "eslint": "10.15.0",
    "fast-check": "4.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  }
}
