{
  "name": "better-directions",
  "private": true,
  "version": "0.1.0",
  "description": "A deliberately silly walking router. Static web app.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test",
    "bench": "vitest run --config vitest.bench.config.ts app/bench/route.bench.ts --silent=false --disableConsoleIntercept",
    "samples": "vitest run --config vitest.bench.config.ts app/bench/samples.bench.ts",
    "dev": "node scripts/tile-graph.mjs && vite",
    "build": "node scripts/tile-graph.mjs && vite build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs",
    "perf": "node scripts/perf.mjs",
    "notices": "node scripts/notices.mjs",
    "tiles": "node scripts/tile-graph.mjs",
    "pages:local": "npm run build && vite preview",
    "pages:gz": "npm run build && node scripts/serve-gz.mjs dist"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.7",
    "eslint": "10.15.0",
    "fast-check": "4.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@protomaps/basemaps": "5.7.2",
    "maplibre-gl": "6.19.0"
  }
}
